rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== 가족 그룹 =====
    match /families/{familyId} {
      // 가족 구성원만 읽기 가능
      allow read: if request.auth != null
        && request.auth.uid in resource.data.members.map(m, m.uid);

      // 새 가족 생성: 로그인 사용자만
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;

      // 수정: 가족 구성원만 (멤버 추가/탈퇴)
      allow update: if request.auth != null
        && (request.auth.uid in resource.data.members.map(m, m.uid)
            || request.auth.uid == resource.data.ownerId);

      // 삭제: 소유자만
      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;

      // ===== 공유 기록 =====
      match /records/{recordId} {
        // 가족 구성원만 읽기/쓰기
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.members.map(m, m.uid);
      }
    }

    // ===== NLP 익명 분석 데이터 (기존) =====
    match /nlp_logs/{logId} {
      allow create: if request.auth != null;
      allow read: if false; // 관리자만 콘솔에서 확인
    }
  }
}

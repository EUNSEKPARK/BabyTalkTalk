rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== 가족 그룹 =====
    match /families/{familyId} {
      // 가족 구성원만 읽기 가능
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberUids;

      // 새 가족 생성: 로그인 사용자만
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;

      // 수정: 가족 구성원이거나, 초대코드로 참여하는 경우 허용
      allow update: if request.auth != null
        && (request.auth.uid in resource.data.memberUids
            || request.auth.uid == resource.data.ownerId);

      // 삭제: 소유자만
      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;

      // ===== 초대 코드 조회용 (가족 참여) =====
      // list 쿼리는 위의 read로 커버 안 되므로 별도 처리 불가
      // → 아래 invites 컬렉션으로 해결

      // ===== 공유 기록 =====
      match /records/{recordId} {
        // 가족 구성원만 읽기/쓰기
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.memberUids;
      }
    }

    // ===== 초대 코드 조회용 (공개 읽기, 생성/삭제는 인증 사용자만) =====
    match /invites/{code} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null;
    }

    // ===== NLP 익명 분석 데이터 (기존) =====
    match /nlp_logs/{logId} {
      allow create: if request.auth != null;
      allow read: if false; // 관리자만 콘솔에서 확인
    }
  }
}
